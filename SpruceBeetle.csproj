<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Version>2.0.0</Version>
    <Title>SpruceBeetle</Title>
    <Description>A toolkit for working with timber offcuts and reclaimed timber</Description>
    <TargetExt>.gha</TargetExt>
    <Authors>Dominik Reisach</Authors>
    <Company>Bauhaus-University Weimar</Company>
  </PropertyGroup>
	
    <PropertyGroup>
   <LangVersion>latest</LangVersion>
</PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/*.png" LogicalName="SpruceBeetle.Resources.%(Filename).png" />
  </ItemGroup>

		
	
	
  
  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="7.15.22039.13001" IncludeAssets="compile;build" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0">
      <IncludeAssets></IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
  
  <PropertyGroup Condition="$(Configuration) == 'Debug' AND $([MSBuild]::IsOSPlatform(Windows))">
    <StartProgram>C:\Program Files\Rhino 7\System\Rhino.exe</StartProgram>
    <StartArguments></StartArguments>
    <StartAction>Program</StartAction>
  </PropertyGroup>
  
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="$([MSBuild]::IsOSPlatform(Windows))">
    <Exec Command="Copy &quot;$(TargetPath)&quot; &quot;C:\Users\Dominik\AppData\Roaming\Grasshopper\Libraries\SpruceBeetle\SpruceBeetle.gha&quot;&#xD;&#xA;Erase &quot;$(TargetPath)&quot;" />
  </Target>

  <Target Name="PostBuildMac" AfterTargets="PostBuildEvent" Condition="$([MSBuild]::IsOSPlatform(OSX))">
    <PropertyGroup>
      <GrasshopperLibraries>$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/Plug-ins/Grasshopper (b45a29b1-4343-4035-989e-044e8580d9cf)/Libraries/SpruceBeetle</GrasshopperLibraries>
    </PropertyGroup>
    <MakeDir Directories="$(GrasshopperLibraries)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GrasshopperLibraries)" />
  </Target>

</Project>